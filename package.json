{
  "name": "dobble-algorithm",
  "version": "1.0.0",
  "description": "TypeScript implementation of the Dobble (Spot It!) card generation algorithm, plus an installable PWA for building a deck from your own photos",
  "type": "module",
  "main": "src/dobble.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo": "tsx src/cli.ts",
    "test": "tsc --noEmit"
  },
  "keywords": [
    "dobble",
    "spot-it",
    "card-game",
    "projective-plane",
    "algorithm",
    "combinatorics",
    "pwa",
    "photo-upload"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
